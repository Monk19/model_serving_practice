pipeline{

    agent {label  'mlops-worker'}

    stages{
        stage('Cleanup'){
            steps{
                echo 'Cleaning up old containers ....'
                // Removes old version if it exists so we don't have name conflicts
                sh "docker rmi my-fastapi-app:latest || true"
                sh "docker image prune -f"
            }
        }
        stage('Checkout Code'){
            steps{

                checkout scm
             }
        }

        stage('Build Image'){
            steps{
                echo 'Building ML Model into a Docker Image...'
                sh 'docker build -t my-fastapi-app:${BUILD_NUMBER} .'
                sh 'docker tag my-fastapi-app:${BUILD_NUMBER} mdock1997/houseprice-predictor:${BUILD_NUMBER}'
                echo 'Pushing Docker image to docker hub we can login using docker login'
                sh 'docker push mdock1997/houseprice-predictor:${BUILD_NUMBER}'
            }
        }
        stage('Deploy Locally') {
            steps{

                echo 'Starting the Model Server on Port 8080...'
                sh """ sed -i 's/house-price-predictor:latest/mdock1997\/houseprice-predictor:${BUILD_NUMBER}/g' deployment.yaml """
                sh 'kubectl apply -f deployment.yaml'
                sh 'kubectl apply -f ml-service.yaml'
                sh 'kubectl get pods'
                sh 'env'
                // sh 'docker run -d -p 8080:8000 --name house-predictor-container my-fastapi-app:${BUILD_NUMBER}'
            }
        }
        
    }

    post {
        always {
            // Cleans up unused containers and dangling images
            sh 'docker system prune -f'
            echo 'Cleaning up the workspace...'
            cleanWs()
            }
        }

}
